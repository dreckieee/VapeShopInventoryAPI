    {
      "name": "GET Products/{productId}",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Returns the requested product's id\", function () {\r\n    const body = pm.response.json();\r\n    pm.expect(body.id).to.eql(Number(pm.collectionVariables.get(\"productId\")));\r\n});\r\n\r\npm.test(\"Returns the requested product's name\", function () {\r\n    const body = pm.response.json();\r\n    pm.expect(body.name).to.eql(\"Postman Test Vape Juice 30ml\");\r\n});\r\n\r\npm.test(\"Returns the requested product's low stock level status\", function () {\r\n    const body = pm.response.json();\r\n    pm.expect(body.isLowStock).to.eql(false);\r\n});"
            ]
          }
        }
      ],
