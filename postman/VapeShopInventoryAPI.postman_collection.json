    {
      "name": "POST Products",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201\", function () {\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\npm.test(\"Response name matches what was sent\", function () {\r\n    const body = pm.response.json();\r\n    pm.expect(body.name).to.eql(\"Postman Test Vape Juice 30ml\");\r\n});\r\n\r\npm.test(\"Response price matches what was sent\", function () {\r\n    const body = pm.response.json();\r\n    pm.expect(body.price).to.eql(250);\r\n});\r\n\r\npm.test(\"Response isLowStock correctly shows if stockQuantity is equal to or below lowStockLevel\", function () {\r\n    const body = pm.response.json();\r\n    pm.expect(body.isLowStock).to.eql(false);\r\n});\r\n\r\npm.collectionVariables.set(\"productId\", pm.response.json().id);\r\npm.collectionVariables.set(\"productSku\", pm.response.json().sku);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"name\": \"Postman Test Vape Juice 30ml\",\r\n  \"sku\": \"PM-{{$randomUUID}}\",\r\n  \"price\": 250.00,\r\n  \"stockQuantity\": 20,\r\n  \"lowStockLevel\": 5,\r\n  \"category\": \"E-liquid\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/products",
