                "exec": [
                  "pm.test(\"Status is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\nconst body = pm.response.json();\r\nconst productId = Number(pm.collectionVariables.get(\"cashFlowProductId\"));\r\nconst product = body.updatedProducts.find(p => p.id === productId);\r\n\r\npm.test(\"Expense total amount is 2000\", function () {\r\n    pm.expect(body.expense.amount).to.eql(2000); // 20 quantity * 100 unit cost = 2000\r\n});\r\n\r\npm.test(\"Product exists\", function () {\r\n    pm.expect(product).to.not.be.undefined;\r\n});\r\n\r\npm.test(\"Stock quantity is 20\", function () {\r\n    pm.expect(product?.stockQuantity).to.eql(20); // restocked 20 onto a product that started at 0\r\n});"
                ]
              }
            }
